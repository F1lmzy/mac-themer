# Rendered from theme.toml into the pack directory, because the active-theme
# symlink points at the pack and a consumer resolving it reads these names
# next to it. Committed theme.toml is the source; these are output.
themes/*/colors.toml
themes/*/ghostty.conf

__pycache__/
*.pyc
.DS_Store
/tmp/

# A fetched theme is staged under a hidden name inside the collection and only
# becomes a pack in one rename, so a failed import cannot disturb the catalog.
themes/.install-*/
themes/.removed-*/
