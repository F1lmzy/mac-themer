#!/usr/bin/env python3
"""mac-themer - theme packs, palette fan-out and the border ring.

One command for the whole desktop look: pick a pack, render every consumer's
format from it, tell the apps that are running to repaint, and keep the
machine-readable palette that new consumers read instead of parsing shell.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from macthemer import __version__, apply as apply_mod, palette, paths, render  # noqa: E402
from macthemer import install as install_mod  # noqa: E402
from macthemer import tokens as tokens_mod  # noqa: E402

# The consumer sends the resolved catalog entry back as the only authorization
# for a write. Bound it so a forged or runaway argument cannot be parsed here.
MAX_EXPECTED_BYTES = 65536


def die(message):
    print("mac-themer: %s" % message, file=sys.stderr)
    raise SystemExit(1)


def slugs():
    found = palette.packs(paths.themes_dir())
    if not found:
        die("no theme packs in %s" % paths.themes_dir())
    return found


def current_slug():
    link = paths.current_link()
    if link.is_symlink():
        return Path(os.readlink(link)).name
    return None


def load(slug=None):
    found = slugs()
    wanted = slug or current_slug() or found[0]
    if wanted not in found:
        for candidate in found:
            if palette.load_pack(paths.themes_dir(), candidate).name.lower() == wanted.lower():
                return palette.load_pack(paths.themes_dir(), candidate)
        die("unknown theme %r; available: %s" % (wanted, ", ".join(found)))
    return palette.load_pack(paths.themes_dir(), wanted)


def resolved_for(theme):
    tokens = tokens_mod.tokens_for(theme)
    return tokens, tokens_mod.bar_for(theme, tokens)


def cmd_list(args):
    found = slugs()
    if args.json:
        print(json.dumps([{"slug": slug,
                           "name": palette.load_pack(paths.themes_dir(), slug).name}
                          for slug in found], indent=2))
        return 0
    active = current_slug()
    for slug in found:
        name = palette.load_pack(paths.themes_dir(), slug).name
        print("%s %s  %s" % ("*" if slug == active else " ", slug, name))
    return 0


def cmd_current(args):
    if args.json:
        if not paths.resolved_file().is_file():
            die("no theme applied yet")
        print(paths.resolved_file().read_text(), end="")
        return 0
    print(current_slug() or "none")
    return 0


def cmd_catalog(args):
    """Every pack's resolved palette and wallpaper identities, read-only and
    path-free.

    Unlike the other commands this does not consult the active theme and does
    not require any pack to exist: an empty catalog is valid output.
    """
    try:
        themes = palette.catalog(paths.themes_dir())
    except palette.ThemeError as exc:
        die(str(exc))
    entries = []
    wallpapers = {}
    for theme in themes:
        tokens = tokens_mod.tokens_for(theme)
        entries.append(render.palette_entry(theme, tokens, tokens_mod.bar_for(theme, tokens)))
        try:
            wallpapers[theme.slug] = apply_mod.wallpaper_ids(theme)
        except palette.ThemeError as exc:
            die(str(exc))
    if args.json:
        print(json.dumps({"schema": 1, "themes": entries, "wallpapers": wallpapers},
                         indent=2))
        return 0
    for entry in entries:
        found = len(wallpapers[entry["slug"]])
        note = "" if not found else "  %d wallpaper%s" % (found, "" if found == 1 else "s")
        print("%s  %s (%s)%s" % (entry["slug"], entry["name"], entry["variant"], note))
    return 0


def cmd_apply(args):
    """Apply one exact catalog pack, but only after a full palette check.

    `catalog` is the read side of the shared browse. This is the write side:
    it reloads the same strict catalog, selects one exact ASCII slug and
    refuses to touch anything until the resolved, path-free palette still
    equals the copy the consumer sent. The expected palette, not the slug, is
    the authorization; a caller can never name a path directly.

    `--background ID` additionally sets one of the pack's own wallpapers, using
    the identity `catalog` published for it. Without the flag the wallpaper is
    left alone, so an older consumer keeps its exact previous behaviour.
    """
    if not palette.SLUG.match(args.slug or ""):
        die("invalid theme slug %r" % args.slug)
    raw = args.expected_palette
    if raw is None or len(raw.encode("utf-8")) > MAX_EXPECTED_BYTES:
        die("--expected-palette must be at most %d bytes" % MAX_EXPECTED_BYTES)
    try:
        expected = json.loads(raw)
    except (ValueError, TypeError) as exc:
        die("expected palette is not valid JSON: %s" % exc)
    if not isinstance(expected, dict):
        die("expected palette must be a JSON object")
    try:
        themes = palette.catalog(paths.themes_dir())
    except palette.ThemeError as exc:
        die(str(exc))
    theme = next((entry for entry in themes if entry.slug == args.slug), None)
    if theme is None:
        die("unknown theme %r" % args.slug)
    tokens = tokens_mod.tokens_for(theme)
    current = render.palette_entry(theme, tokens, tokens_mod.bar_for(theme, tokens))
    # Exact serialized comparison on purpose: it rejects extra, missing and
    # non-integral fields, not just a different colour. Anything less would let
    # a forged document through the same door as the real one.
    if json.dumps(current, sort_keys=True) != json.dumps(expected, sort_keys=True):
        die("catalog changed: expected palette no longer matches %r" % args.slug)
    background = None
    if args.background is not None:
        background = apply_mod.wallpaper_path(theme, args.background)
        if background is None:
            die("theme %r has no background %r" % (theme.slug, args.background))
    try:
        actions = apply_mod.apply(theme, wallpaper=background is not None, background=background)
    except Exception as exc:  # noqa: BLE001 - reported honestly, not swallowed
        die("apply failed after possible partial changes: %s" % exc)
    warnings = []
    if any("reload failed" in action for action in actions):
        warnings.append("ghosttyReloadFailed")
    # A background that could not be set is reported, never assumed: the helper
    # may fall back to AppleScript, and that can fail on its own.
    wallpaper = None
    if background is not None:
        if any("wallpaper failed" in action for action in actions):
            warnings.append("wallpaperFailed")
        else:
            wallpaper = background.name
    if args.json:
        print(json.dumps({"schema": 1, "status": "applied", "theme": theme.slug,
                          "wallpaper": wallpaper, "warnings": warnings}, indent=2))
        return 0
    print("theme: %s (%s)" % (theme.name, theme.slug))
    if wallpaper is not None:
        print("background: %s" % wallpaper)
    for warning in warnings:
        print("  warning: %s" % warning)
    return 0


def cmd_dump(args):
    theme = load(args.slug)
    tokens, bar = resolved_for(theme)
    if args.json:
        print(render.resolved_json(theme, tokens, bar), end="")
        return 0
    print("theme: %s (%s)" % (theme.name, theme.slug))
    for key in sorted(theme.palette):
        print("palette.%-22s %s" % (key, theme.palette[key]))
    for key in tokens:
        print("tokens.%-23s %s" % (key, tokens[key]))
    print("border.active          %s" % theme.border["active"])
    print("border.inactive        %s" % theme.border["inactive"])
    for key in sorted(bar):
        print("bar.%-26s %s" % (key, bar[key]))
    return 0


def cmd_set(args):
    theme = load(args.slug)
    actions = apply_mod.apply(theme, wallpaper=not args.no_wallpaper,
                              korren_flag=not args.no_korren, reload=not args.no_reload,
                              index=args.background_index)
    if args.json:
        print(json.dumps({"theme": theme.slug, "actions": actions}, indent=2))
        return 0
    print("theme: %s (%s)" % (theme.name, theme.slug))
    for action in actions:
        print("  %s" % action)
    return 0


def cmd_next(args):
    found = slugs()
    active = current_slug()
    following = found[(found.index(active) + 1) % len(found)] if active in found else found[0]
    args.slug = following
    return cmd_set(args)


def cmd_bg_next(args):
    theme = load(args.slug)
    pictures = apply_mod.backgrounds(theme)
    if not pictures:
        die("theme %s has no backgrounds" % theme.slug)
    if args.path:
        target = Path(args.path).expanduser().resolve()
        if not target.is_file():
            die("no such image: %s" % target)
    else:
        target = pictures[0]
        link = paths.run_dir() / "background"
        if link.is_symlink():
            for index, picture in enumerate(pictures):
                try:
                    matches = os.path.samefile(picture, link)
                except OSError:
                    matches = False
                if matches:
                    target = pictures[(index + 1) % len(pictures)]
                    break
    apply_mod.remember_background(target)
    outcome = apply_mod.set_wallpaper(target)
    if outcome is None:
        die("could not set the wallpaper to %s" % target.name)
    print("background: %s (%s)" % (target.name, outcome))
    return 0


def cmd_wallpaper(args):
    """Set one published wallpaper of a pack, leaving the theme alone.

    The identity is the one `catalog --json` published for that pack, so a
    caller still cannot name a path. No theme file, app setting or Ghostty
    fragment is rewritten: only the desktop picture and the remembered
    background move.
    """
    try:
        themes = palette.catalog(paths.themes_dir())
    except palette.ThemeError as exc:
        die(str(exc))
    theme = next((entry for entry in themes if entry.slug == args.slug), None)
    if theme is None:
        die("unknown theme %r" % args.slug)
    try:
        pictures = apply_mod.wallpaper_ids(theme)
    except palette.ThemeError as exc:
        die(str(exc))
    if args.wallpaper_id not in pictures:
        die("theme %r has no wallpaper %r" % (theme.slug, args.wallpaper_id))
    target = apply_mod.wallpaper_path(theme, args.wallpaper_id)
    apply_mod.remember_background(target)
    outcome = apply_mod.set_wallpaper(target)
    warnings = [] if outcome is not None else ["wallpaperFailed"]
    if args.json:
        print(json.dumps({"schema": 1, "status": "set" if outcome else "failed",
                          "theme": theme.slug, "wallpaper": args.wallpaper_id,
                          "warnings": warnings}, indent=2))
        return 0 if outcome is not None else 1
    print("background: %s (%s)" % (args.wallpaper_id, outcome or "failed"))
    return 0 if outcome is not None else 1


def cmd_render(args):
    """Render a pack without touching the desktop. Used by the test suite."""
    theme = load(args.slug)
    tokens, bar, written = apply_mod.render_pack(theme)
    if args.state:
        state = Path(args.state).expanduser()
        apply_mod.write_atomic(state / "current.json", render.resolved_json(theme, tokens, bar))
        apply_mod.relink(state / "current", theme.source.parent)
    if args.json:
        print(json.dumps({"theme": theme.slug, "written": written}, indent=2))
    else:
        for name in written or ["(already current)"]:
            print("%s/%s" % (theme.source.parent, name))
    return 0


def launchctl_loaded(label):
    return subprocess.run(["launchctl", "print", "gui/%d/%s" % (os.getuid(), label)],
                          capture_output=True).returncode == 0


def other_ring_agents():
    """Any loaded agent that looks like a second ring daemon.

    mac-themer manages only its own agent. If something else is drawing a ring
    too, the honest move is to name it and let you decide, not to reach over and
    stop another project's service.
    """
    result = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
    found = set()
    for line in result.stdout.splitlines():
        fields = line.split()
        if len(fields) >= 3 and "borders" in fields[2].lower() \
                and fields[2] != "com.macthemer.borders":
            found.add(fields[2])
    return sorted(found)


def cmd_doctor(args):
    repo = paths.repo_root()
    print("repo:      %s" % repo)
    print("version:   %s" % __version__)
    print("packs:     %s" % ", ".join(slugs()))
    print("state:     %s" % paths.state_dir())
    print("current:   %s" % (current_slug() or "none"))
    print("resolved:  %s" % ("present" if paths.resolved_file().is_file() else "missing"))
    print("ghostty:   %s" % ("present" if paths.ghostty_fragment().is_file() else "missing"))
    print("borders:   %s" % ("loaded" if launchctl_loaded("com.macthemer.borders") else "not loaded"))
    for label in other_ring_agents():
        print("conflict:  %s is loaded too - two rings will overlap." % label)
    theme_set = paths.bin_dir() / "theme-set"
    if theme_set.is_symlink():
        print("theme-set: %s" % os.readlink(theme_set))
    elif theme_set.exists():
        print("theme-set: a real file, not a mac-themer symlink")
    else:
        print("theme-set: not installed")
    if apply_mod.wallpaper_helper() is not None:
        print("wallpaper: %s" % apply_mod.wallpaper_helper())
    else:
        print("wallpaper: osascript fallback (run install.sh to build the helper)")
    background = paths.backgrounds_link()
    if background.is_symlink():
        print("background: %s" % os.readlink(background))
    return 0


def cmd_theme_install(args):
    """Install a theme from a GitHub repository as one or more packs.

    Only `colors.toml` and `backgrounds/` travel from the repository: the rest
    of an Omarchy theme is that desktop's generated files, not a palette. The
    URL is the one argument a caller supplies, so it is validated here before
    git runs and again by the clone's own transport restriction.
    """
    try:
        result = install_mod.install(args.url, slug=args.slug,
                                     all_themes=args.all, force=args.force)
    except (install_mod.InstallError, OSError) as exc:
        die(str(exc))
    if args.json:
        print(json.dumps({"schema": 1, "status": "installed",
                          "packs": result["packs"]}, indent=2))
        return 0
    for pack in result["packs"]:
        count = pack["wallpapers"]
        print("%s %s (%s) with %d wallpaper%s" % (
            "reinstalled" if pack["replaced"] else "installed",
            pack["slug"], pack["name"], count, "" if count == 1 else "s"))
    return 0


def cmd_theme_uninstall(args):
    """Remove a pack from the collection. Never removes the active one."""
    try:
        result = install_mod.uninstall(args.slug)
    except (install_mod.InstallError, OSError) as exc:
        die(str(exc))
    if args.json:
        print(json.dumps({"schema": 1, "status": "removed",
                          "slug": result["slug"]}, indent=2))
        return 0
    print("removed %s" % result["slug"])
    return 0


def cmd_script(args):
    script = paths.repo_root() / ("%s.sh" % args.action)
    if not script.is_file():
        die("no %s in %s" % (script.name, paths.repo_root()))
    return subprocess.run(["bash", str(script)] + args.rest).returncode


def build_parser():
    parser = argparse.ArgumentParser(prog="mac-themer", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version="mac-themer %s" % __version__)
    sub = parser.add_subparsers(dest="command")

    listing = sub.add_parser("list", help="list installed theme packs")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(handler=cmd_list)

    current = sub.add_parser("current", help="print the active theme")
    current.add_argument("--json", action="store_true")
    current.set_defaults(handler=cmd_current)

    dump = sub.add_parser("dump", help="print a pack's resolved palette")
    dump.add_argument("slug", nargs="?")
    dump.add_argument("--json", action="store_true")
    dump.set_defaults(handler=cmd_dump)

    catalog_cmd = sub.add_parser("catalog", help="print every pack's resolved palette")
    catalog_cmd.add_argument("--json", action="store_true")
    catalog_cmd.set_defaults(handler=cmd_catalog)

    apply_cmd = sub.add_parser("apply", help="apply one pack after checking its palette")
    apply_cmd.add_argument("slug")
    apply_cmd.add_argument("--expected-palette", required=True)
    apply_cmd.add_argument("--background", metavar="ID",
                           help="also set this wallpaper from the pack")
    apply_cmd.add_argument("--json", action="store_true")
    apply_cmd.set_defaults(handler=cmd_apply)

    initial = sub.add_parser("set", help="apply a theme pack")
    initial.add_argument("slug")
    initial.add_argument("--no-wallpaper", action="store_true")
    initial.add_argument("--no-korren", action="store_true")
    initial.add_argument("--no-reload", action="store_true")
    initial.add_argument("--background-index", type=int, default=0)
    initial.add_argument("--json", action="store_true")
    initial.set_defaults(handler=cmd_set)

    following = sub.add_parser("next", help="apply the next pack in order")
    following.add_argument("--no-wallpaper", action="store_true")
    following.add_argument("--no-korren", action="store_true")
    following.add_argument("--no-reload", action="store_true")
    following.add_argument("--background-index", type=int, default=0)
    following.add_argument("--json", action="store_true")
    following.set_defaults(handler=cmd_next)

    background = sub.add_parser("bg-next", help="cycle the theme's backgrounds")
    background.add_argument("path", nargs="?")
    background.add_argument("--slug")
    background.set_defaults(handler=cmd_bg_next)

    wallpaper = sub.add_parser("wallpaper", help="set one wallpaper from a pack")
    wallpaper.add_argument("slug")
    wallpaper.add_argument("--id", required=True, dest="wallpaper_id", metavar="ID")
    wallpaper.add_argument("--json", action="store_true")
    wallpaper.set_defaults(handler=cmd_wallpaper)

    render_cmd = sub.add_parser("render", help="render a pack's files without applying")
    render_cmd.add_argument("slug", nargs="?")
    render_cmd.add_argument("--state")
    render_cmd.add_argument("--json", action="store_true")
    render_cmd.set_defaults(handler=cmd_render)

    doctor = sub.add_parser("doctor", help="report state and conflicting installs")
    doctor.set_defaults(handler=cmd_doctor)

    for action, help_text in (("install", "build the border ring and wire the CLI up"),
                              ("uninstall", "remove the border ring and the symlinks")):
        script = sub.add_parser(action, help=help_text)
        script.add_argument("rest", nargs=argparse.REMAINDER)
        script.set_defaults(handler=cmd_script, action=action)

    fetch = sub.add_parser("theme-install",
                           help="install a theme pack from a GitHub repository")
    fetch.add_argument("url", help="https://github.com/<owner>/<repo>")
    fetch.add_argument("--slug", help="name the pack instead of deriving it from the repo")
    fetch.add_argument("--all", action="store_true",
                       help="install every theme the repository states")
    fetch.add_argument("--force", action="store_true",
                       help="replace a pack this command did not install")
    fetch.add_argument("--json", action="store_true")
    fetch.set_defaults(handler=cmd_theme_install)

    remove = sub.add_parser("theme-uninstall", help="remove an installed theme pack")
    remove.add_argument("slug")
    remove.add_argument("--json", action="store_true")
    remove.set_defaults(handler=cmd_theme_uninstall)
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "handler", None):
        parser.print_help()
        return 2
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main())
